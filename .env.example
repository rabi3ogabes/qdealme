APP_NAME=QDealMe
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql

# Supabase (recommended for production). In the Supabase dashboard open
# Connect > Session pooler, copy the URI and put your database password in it.
# The session pooler (port 5432) works over IPv4 and supports the prepared
# statements Laravel uses; avoid the transaction pooler (port 6543).
# DB_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
# DB_SSLMODE=require

# Local PostgreSQL (development). Ignored when DB_URL is set.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=qdealme
DB_USERNAME=qdealme
DB_PASSWORD=secret
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@qdealme.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=UTC

QDEALME_DOMAIN=qdealme.com
QDEALME_SUPPORT_EMAIL=hello@qdealme.com
QDEALME_LEGAL_NAME=QDealMe
QDEALME_RASTERIZE_DPI=150
QDEALME_MAX_UPLOAD_MB=80

# Initial super admin created by the seeder. Change the password after first login.
ADMIN_EMAIL=admin@qdealme.com
ADMIN_PASSWORD=
ADMIN_REQUIRE_MFA=true

# Media storage. "disk" keeps flyer images on this server. "cloud" uses an
# S3-compatible service (Cloudflare R2, Supabase Storage, AWS S3); Vercel
# needs "cloud". See docs/VERCEL.md.
MEDIA_STORAGE=disk
MEDIA_ENDPOINT=
MEDIA_REGION=auto
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BUCKET=
MEDIA_PRIVATE_BUCKET=
MEDIA_PUBLIC_URL=

# "auto" resizes flyer pages and accepts PDFs when the server supports it;
# "basic" stores images as uploaded and refuses PDFs (Vercel).
QDEALME_IMAGE_PROCESSING=auto

# Secret for /cron/flyers/roll (Vercel Cron). Leave empty to disable.
CRON_SECRET=

# Set to * when running behind Vercel or a reverse proxy.
TRUSTED_PROXIES=
